# ============================================================
# Tay Performance — configuration Apache (Hostinger)
# ============================================================

# DirectorySlash Off empêche Apache de rediriger /reserver vers /reserver/
# quand le dossier pré-rendu existe : l'URL reste celle du canonical.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 1. Une seule URL canonique : https, sans www -------------------------
  # Sans ça, https://www.tayperformance.fr et http:// sont vus par Google comme
  # des sites distincts et la popularité se divise entre eux.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # --- 2. Pas de slash final (le canonical du site n'en a pas) --------------
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # --- 3. Fichier réel : on le sert tel quel --------------------------------
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # --- 4. Page pré-rendue (scripts/prerender.mjs) ---------------------------
  # /reserver → dist/reserver/index.html, qui porte le bon <title> et le bon
  # canonical pour les crawlers qui n'exécutent pas JavaScript.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]

  # --- 5. Repli SPA ---------------------------------------------------------
  RewriteRule ^ /index.html [L]
</IfModule>

# ============================================================
# Cache
# ============================================================
<IfModule mod_headers.c>
  # index.html porte les balises SEO : il ne doit jamais rester en cache,
  # sinon un déploiement ne change rien pour les visiteurs déjà venus.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|mp4|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Sécurité — sans incidence SEO directe, mais Google et les navigateurs
  # pénalisent les sites qui laissent passer n'importe quoi.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# ============================================================
# Compression — divise par 3 à 5 le poids du bundle JS/CSS
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest
